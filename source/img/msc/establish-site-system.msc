# MSC for establish site-system

msc {
  hscale = "1.5", arcgradient = "0";

  a [label="Site"], b [label="Supervision system"];

  a=>b [ label = "Version request" ];
  |||;
  b abox b [ label = "Process Version request and verify site id" ];
  |||;
  a<=b [ label = "Version response" ];
  |||;
  a abox a [ label = "Process Version response" ];
  |||;
  --- [ label = "Selected core version is used for subsequent messages" ];
  |||;
  a=>b [ label = "Watchdog" ];
  |||;
  a<=b [ label = "Watchdog" ];
  |||;
  a=>b [ label = "ComponentList" ];
  |||;
  a=>b [ label = "AggregatedStatus (entire site)" ];
  |||;
  a<<b [ label = "MessageAck (AggregatedStatus)" ];
  |||;
  --- [ label = "Establishment complete; asynchronous message exchange can begin" ];
  |||;
  a=>b [ label = "Alarms from accepted SXLs (unless useAlarms=false)" ];
  |||;
  a=>b [ label = "Permitted buffered messages (no alarms if useAlarms=false)" ];
  |||;
}
