{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initial Version validation",
  "description": "Preliminary checks before selecting Core; full validation against the selected version is still required",
  "type": "object",
  "properties": {
    "mType": { "const": "rSMsg" },
    "type": { "const": "Version" },
    "RSMP": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "vers": {
            "allOf": [
              { "$ref": "definitions.json#/rsmp_string" },
              { "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" }
            ]
          }
        },
        "required": ["vers"],
        "additionalProperties": true
      }
    }
  },
  "required": ["mType", "type", "RSMP"],
  "additionalProperties": true
}
